# Copy to the data folder (/opt/backtest/.env on the VPS) and fill in. Never commit the real file.
# install.sh copies DATABASE_URL across from the downloader's own .env when it can.

# The market-data archive. Read-only is enough - the backtest never writes to PostgreSQL.
DATABASE_URL=

# Where results go. The same database the dashboard reads live trades from.
MONGO_CONNECTION_STRING=
MONGO_DB=nifty200desk
