# /opt/marketdata/.env on the VPS (install.sh creates it from this file, chmod 600).
# Never commit or share the filled-in file.

# PostgreSQL on this VPS (the password you chose when creating the database)
DATABASE_URL=postgresql://marketdata:CHANGE_ME@localhost:5432/marketdata

# Dhan
DHAN_CLIENT_ID=your-dhan-client-id
DHAN_PIN=your-6-digit-dhan-pin
DHAN_TOTP_SECRET=the-secret-shown-once-when-you-set-up-totp

# test = 15 trading days, 5 stocks (run this first)   year = 250 trading days, all NIFTY 200 stocks
MARKETDATA_PROFILE=test
